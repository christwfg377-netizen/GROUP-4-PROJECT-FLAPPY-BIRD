def blend(color, target, amount):
    return tuple(int(color[i] * (1 - amount) + target[i] * amount) for i in range(3))


def make_vertical_gradient(top, bottom):
    key = (top, bottom)
    if key in gradient_cache:
        return gradient_cache[key]

    surface = pygame.Surface((WIDTH, HEIGHT))
    for y in range(HEIGHT):
        t = y / HEIGHT
        color = blend(top, bottom, t)
        pygame.draw.line(surface, color, (0, y), (WIDTH, y))

    gradient_cache[key] = surface
    return surface


def draw_asset_cloud(surface, x, y, width, height, alpha=190):
    pieces = [
        (0.02, 0.44, 0.36, 0.42),
        (0.18, 0.24, 0.42, 0.52),
        (0.44, 0.12, 0.42, 0.62),
        (0.66, 0.34, 0.32, 0.44),
