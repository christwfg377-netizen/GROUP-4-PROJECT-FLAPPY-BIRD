    for px, py, pw, ph in pieces:
        rect = pygame.Rect(x + width * px, y + height * py, width * pw, height * ph)
        pygame.draw.ellipse(surface, (255, 255, 255, alpha), rect)
    pygame.draw.ellipse(surface, (221, 247, 247, alpha // 2), (x + width * 0.1, y + height * 0.56, width * 0.78, height * 0.3))


