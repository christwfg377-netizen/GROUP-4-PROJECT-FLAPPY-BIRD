def tokenize(text):
    return WORD_RE.findall(text.lower())


def make_ngrams(words, size):
    if len(words) < size:
        return []
    return [" ".join(words[index:index + size]) for index in range(len(words) - size + 1)]


def cosine_similarity(words_a, words_b):
    counts_a = Counter(words_a)
    counts_b = Counter(words_b)
    all_words = set(counts_a) | set(counts_b)
    dot_product = sum(counts_a[word] * counts_b[word] for word in all_words)
    length_a = math.sqrt(sum(value * value for value in counts_a.values()))
    length_b = math.sqrt(sum(value * value for value in counts_b.values()))

    if length_a == 0 or length_b == 0:
        return 0.0
    return dot_product / (length_a * length_b)


def jaccard_similarity(items_a, items_b):
    set_a = set(items_a)
    set_b = set(items_b)

    if not set_a and not set_b:
        return 0.0
    return len(set_a & set_b) / len(set_a | set_b)


def find_shared_phrases(words_a, words_b, phrase_size, limit=12):
    phrases_a = Counter(make_ngrams(words_a, phrase_size))
    phrases_b = Counter(make_ngrams(words_b, phrase_size))
    shared = phrases_a.keys() & phrases_b.keys()
    ranked = sorted(
        shared,
        key=lambda phrase: (min(phrases_a[phrase], phrases_b[phrase]), len(phrase)),
        reverse=True,
    )
    return ranked[:limit]


def plagiarism_risk(score):
    if score >= 0.75:
        return "High risk"
    if score >= 0.45:
        return "Medium risk"
    if score >= 0.25:
        return "Low risk"
    return "Very low risk"


def compare_documents(text_a, text_b, phrase_size):
    words_a = tokenize(text_a)
    words_b = tokenize(text_b)
    ngrams_a = make_ngrams(words_a, phrase_size)
    ngrams_b = make_ngrams(words_b, phrase_size)

    word_score = cosine_similarity(words_a, words_b)
    phrase_score = jaccard_similarity(ngrams_a, ngrams_b)
    overall_score = (word_score * 0.55) + (phrase_score * 0.45)

    return {
        "words_a": len(words_a),
        "words_b": len(words_b),
        "word_similarity": word_score,
        "phrase_similarity": phrase_score,
        "overall_similarity": overall_score,
        "risk": plagiarism_risk(overall_score),
        "shared_phrases": find_shared_phrases(words_a, words_b, phrase_size),
    }


class SimilarityHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path not in ("/", "/index.html"):
            self.send_error(404, "Page not found")
            return

        body = HTML.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if self.path != "/api/check":
            self.send_error(404, "Page not found")
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
            payload = json.loads(self.rfile.read(length).decode("utf-8"))
            text_a = payload.get("document_a", "")
            text_b = payload.get("document_b", "")
            phrase_size = int(payload.get("phrase_size", 5))

            if not text_a.strip() or not text_b.strip():
                self.send_json({"error": "Please add text to both documents."}, 400)
                return
            if phrase_size < 2 or phrase_size > 12:
                self.send_json({"error": "Phrase size must be between 2 and 12."}, 400)
                return

            self.send_json(compare_documents(text_a, text_b, phrase_size))
        except (ValueError, json.JSONDecodeError):
            self.send_json({"error": "Invalid request data."}, 400)

    def send_json(self, data, status=200):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        return


def main():
    server = ThreadingHTTPServer((HOST, PORT), SimilarityHandler)
    print(f"Document Similarity Checker is running at http://{HOST}:{PORT}")
    print("Press Ctrl+C to stop the website.")
    server.serve_forever()


if __name__ == "__main__":
    main()
