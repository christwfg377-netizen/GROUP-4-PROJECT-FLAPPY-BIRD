def make_pipe_surface(width, height):
    cache_key = (width, height)
    if cache_key in pipe_surface_cache:
        return pipe_surface_cache[cache_key]

    surface = pygame.Surface((width, height), pygame.SRCALPHA)
    pygame.draw.rect(surface, PIPE_DARK, (0, 0, width, height))
    for x in range(2, width - 2):
        t = x / max(1, width - 1)
        highlight = math.exp(-((t - 0.45) ** 2) / 0.03)
        shade = math.exp(-((t - 0.9) ** 2) / 0.02)
        color = (
            int(188 + 58 * highlight - 42 * shade),
            int(94 + 54 * highlight - 18 * shade),
            int(61 + 38 * highlight - 14 * shade),
        )
        pygame.draw.line(surface, color, (x, 0), (x, height))
    pygame.draw.line(surface, (255, 190, 134), (width // 2 - 5, 0), (width // 2 - 5, height), 2)
    pygame.draw.line(surface, (115, 67, 50), (width - 5, 0), (width - 5, height), 2)
    pipe_surface_cache[cache_key] = surface
    return surface


def make_pipe_lip_surface(width, height):
    cache_key = ("lip", width, height)
    if cache_key in pipe_surface_cache:
        return pipe_surface_cache[cache_key]

    surface = pygame.Surface((width, height), pygame.SRCALPHA)
    pygame.draw.rect(surface, PIPE_DARK, (0, 0, width, height))
    for x in range(3, width - 3):
        t = x / max(1, width - 1)
        highlight = math.exp(-((t - 0.45) ** 2) / 0.03)
        color = (
            int(184 + 62 * highlight),
            int(91 + 54 * highlight),
            int(59 + 35 * highlight),
        )
        pygame.draw.line(surface, color, (x, 3), (x, height - 4))
    pygame.draw.line(surface, (255, 190, 134), (width // 2 - 5, 3), (width // 2 - 5, height - 4), 2)
    pipe_surface_cache[cache_key] = surface
