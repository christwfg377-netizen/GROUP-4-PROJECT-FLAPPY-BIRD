def update_level(game_state):
    if game_state["score"] >= 25:
        game_state["level"] = 3
        game_state["speed"] = 5.8
    elif game_state["score"] >= 10:
        game_state["level"] = 2
        game_state["speed"] = 4.8
    else:
        game_state["level"] = 1
        game_state["speed"] = 3.8


def apply_gravity(game_state):
    game_state["velocity"] += GRAVITY


def update_bird_position(game_state):
    game_state["bird_y"] += game_state["velocity"]


def move_pipes_left(game_state):
    step = int(game_state["speed"])
    for pipe in game_state["pipes"]:
        pipe["top"].x -= step
        pipe["bottom"].x -= step
        pipe["coin"].x -= step


def check_score_trigger(game_state):
    for pipe in game_state["pipes"]:
        if not pipe["scored"] and pipe["top"].right < BIRD_X:
            pipe["scored"] = True
            game_state["score"] += 1


def check_coin_collection(game_state):
    global total_coins

    rect = bird_rect(game_state).inflate(-8, -8)

    for pipe in game_state["pipes"]:
        if not pipe["coin_collected"] and rect.colliderect(pipe["coin"]):
            pipe["coin_collected"] = True
            game_state["coins"] += 1
            total_coins += 1
            game_state["score"] += 2


def remove_and_spawn_pipes(game_state):
    if game_state["pipes"][0]["top"].right < 0:
        game_state["pipes"].pop(0)
        last_x = game_state["pipes"][-1]["top"].x
        game_state["pipes"].append(create_pipe(last_x + PIPE_DISTANCE))


def bird_rect(game_state):
    return pygame.Rect(BIRD_X, int(game_state["bird_y"]), BIRD_W, BIRD_H)


def check_collisions(game_state):
    rect = bird_rect(game_state).inflate(-10, -8)

    if rect.top <= 0 or rect.bottom >= HEIGHT - GROUND_HEIGHT:
        return True

    for pipe in game_state["pipes"]:
        if rect.colliderect(pipe["top"]) or rect.colliderect(pipe["bottom"]):
            return True

    return False


