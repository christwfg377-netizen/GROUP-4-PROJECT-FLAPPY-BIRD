def blend(color, target, amount):
    return tuple(int(color[i] * (1 - amount) + target[i] * amount) for i in range(3))


def draw_soft_ellipse(rect, alpha=46):
    shadow = pygame.Surface((rect.w, rect.h), pygame.SRCALPHA)
    pygame.draw.ellipse(shadow, (0, 0, 0, alpha), shadow.get_rect())
    screen.blit(shadow, rect.topleft)


def draw_soft_rect(rect, radius=7, alpha=42):
    shadow = pygame.Surface((rect.w, rect.h), pygame.SRCALPHA)
    pygame.draw.rect(shadow, (0, 0, 0, alpha), shadow.get_rect(), border_radius=radius)
    screen.blit(shadow, rect.topleft)


def make_vertical_gradient(top, bottom):
    key = (top, bottom)
    if key in gradient_cache:
        return gradient_cache[key]

    surface = pygame.Surface((WIDTH, HEIGHT))
    for y in range(HEIGHT):
        t = y / HEIGHT
        color = blend(top, bottom, t)
        pygame.draw.line(surface, color, (0, y), (WIDTH, y))

    gradient_cache[key] = surface
    return surface


