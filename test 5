def render_everything():
    draw_background(ground_scroll, game["level"])
    if game["state"] != STORE:
        draw_pipes(game["pipes"])
        draw_bird(game)
    draw_hud()

    if game["state"] == MENU:
        group_surface = big_font.render("GROUP 4", True, RED)
        screen.blit(group_surface, group_surface.get_rect(center=(WIDTH // 2, 172)))
        draw_center_text("FLAPPY BIRD", "Tap, SPACE, or UP to start", BLACK, 242)
    elif game["state"] == STORE:
        draw_store()
    elif game["state"] == GAME_OVER:
        draw_center_text("GAME OVER", "Tap to restart  |  ESC for menu", RED, 238)

        score_surface = big_font.render(f"Final Score: {game['score']}", True, BLACK)
        coin_surface = font.render(f"Coins Collected: {game['coins']}", True, GOLD_DARK)

        screen.blit(score_surface, score_surface.get_rect(center=(WIDTH // 2, 395)))
        screen.blit(coin_surface, coin_surface.get_rect(center=(WIDTH // 2, 432)))


running = True

while running:
    clock.tick(FPS)
    ground_scroll = (ground_scroll + game["speed"] * 0.8) % 1000

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif game["state"] == STORE and event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                game = go_to_menu()
            elif event.key in (pygame.K_LEFT, pygame.K_a):
                preview_skin = (preview_skin - 1) % len(SKINS)
            elif event.key in (pygame.K_RIGHT, pygame.K_d):
                preview_skin = (preview_skin + 1) % len(SKINS)
            elif event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE):
                skin = SKINS[preview_skin]
                if preview_skin in unlocked_skins:
                    selected_skin = preview_skin
                elif total_coins >= skin["price"]:
                    total_coins -= skin["price"]
                    unlocked_skins.add(preview_skin)
                    selected_skin = preview_skin
        elif game["state"] == MENU and tap_detected(event):
            game = initialize_game()
        elif game["state"] == RUNNING and tap_detected(event):
            game["velocity"] = FLAP_FORCE
        elif game["state"] == GAME_OVER and tap_detected(event):
            game = initialize_game()
        elif game["state"] == GAME_OVER and back_detected(event):
            game = go_to_menu()

    if game["state"] == RUNNING:
        apply_gravity(game)
        update_bird_position(game)
        move_pipes_left(game)
        check_coin_collection(game)
        check_score_trigger(game)
        remove_and_spawn_pipes(game)
        update_level(game)

        if check_collisions(game):
            game["state"] = GAME_OVER
            high_score = max(high_score, game["score"])

    render_everything()
    pygame.display.flip()

pygame.quit()
sys.exit()
