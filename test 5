def draw_coins(pipes):
    return

    pulse = int(math.sin(pygame.time.get_ticks() * 0.01) * 3)
    shine = math.sin(pygame.time.get_ticks() * 0.006)

    for pipe in pipes:
        if pipe["coin_collected"]:
            continue

        coin = pipe["coin"].inflate(pulse, pulse)
        if coin_art is not None:
            frame = pygame.transform.smoothscale(coin_art, coin.size)
            screen.blit(frame, coin.topleft)
        else:
            draw_soft_ellipse(coin.move(3, 4), 42)
            pygame.draw.ellipse(screen, GOLD_DARK, coin)
            pygame.draw.ellipse(screen, GOLD, coin.inflate(-5, -5))
            pygame.draw.ellipse(screen, blend(GOLD, WHITE, 0.45), coin.inflate(-14, -14))
            pygame.draw.line(screen, WHITE, (coin.centerx - 6, coin.y + 8), (coin.centerx + 6, coin.y + 8 + int(shine * 2)), 2)


